# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Test cache ---
.pytest_cache/

# --- Environment / secrets ---
.env
*.local

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store

# --- Data ---
# Raw downloads and processed outputs are NOT version-controlled; we document the
# source instead. The tiny bundled sample IS committed on purpose, so a fresh
# clone (and the test suite) runs without anyone downloading anything first.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# data/sample/ is deliberately NOT ignored.

# --- SAS artefacts ---
*.log
*.lst
*.sas7bdat
*.sas7bcat

# --- Model artefacts ---
*.pkl
*.joblib
logs/
